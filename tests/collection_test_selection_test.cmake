cmake_minimum_required(VERSION 3.21)
find_program(ctest_bin NAMES ctest REQUIRED)
if(NOT DEFINED LOCKDC_COLLECTION_TEST_SUITE)
    set(LOCKDC_COLLECTION_TEST_SUITE lc_unit_collections)
endif()
set(suite "${LOCKDC_COLLECTION_TEST_SUITE}")
if(suite STREQUAL "lc_unit_collections")
    set(suffixes append recovery)
    set(source_name test_lc_collections.c)
elseif(suite STREQUAL "lc_unit_collection_staged")
    set(suffixes streaming conversion)
    set(source_name test_lc_collection_staged.c)
else()
    message(FATAL_ERROR "Unknown collection suite: ${suite}")
endif()
list(GET suffixes 0 second)
list(GET suffixes 1 third)
execute_process(COMMAND "${ctest_bin}" --test-dir "${LOCKDC_BINARY_DIR}"
    --show-only=json-v1 -R "^${suite}($|_${second}$|_${third}$)"
    RESULT_VARIABLE rc OUTPUT_VARIABLE inventory ERROR_VARIABLE error)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Cannot inspect collection partitions: ${error}")
endif()
string(JSON count LENGTH "${inventory}" tests)
if(NOT count EQUAL 3)
    message(FATAL_ERROR "Expected three collection partitions, found ${count}")
endif()
set(expected_groups ${suite} ${suite}_${second} ${suite}_${third})
list(SORT expected_groups)
set(actual_groups)
set(cases)
foreach(index RANGE 0 2)
    string(JSON name GET "${inventory}" tests ${index} name)
    list(APPEND actual_groups "${name}")
    string(JSON length LENGTH "${inventory}" tests ${index} command)
    math(EXPR last "${length} - 1")
    set(found_binary FALSE)
    set(arguments)
    foreach(argument_index RANGE 0 ${last})
        string(JSON argument GET "${inventory}" tests ${index} command ${argument_index})
        if(found_binary)
            list(APPEND arguments "${argument}")
        elseif(argument MATCHES "/${suite}$")
            set(found_binary TRUE)
        endif()
    endforeach()
    if(NOT found_binary OR NOT arguments)
        message(FATAL_ERROR "Empty collection partition: ${name}")
    endif()
    list(APPEND cases ${arguments})
    string(JSON length LENGTH "${inventory}" tests ${index} properties)
    math(EXPR last "${length} - 1")
    set(runtime FALSE)
    set(bounded FALSE)
    foreach(property RANGE 0 ${last})
        string(JSON key GET "${inventory}" tests ${index} properties ${property} name)
        string(JSON value GET "${inventory}" tests ${index} properties ${property} value)
        if(key STREQUAL "LABELS")
            if(value MATCHES "\"cross-runtime\"")
                set(runtime TRUE)
            endif()
            if(value MATCHES "\"(lifecycle-host|release-artifact|native-behavior)\"")
                message(FATAL_ERROR "Collection partition excluded from runtime lane: ${name}")
            endif()
        elseif(key STREQUAL "TIMEOUT" AND value GREATER 0 AND value LESS_EQUAL 60)
            set(bounded TRUE)
        elseif((key STREQUAL "DISABLED" OR key STREQUAL "WILL_FAIL") AND value)
            message(FATAL_ERROR "Collection partition does not require success: ${name}")
        endif()
    endforeach()
    if(NOT runtime OR NOT bounded)
        message(FATAL_ERROR "Collection partition lost runtime coverage or timeout: ${name}")
    endif()
endforeach()
list(SORT actual_groups)
if(NOT actual_groups STREQUAL expected_groups)
    message(FATAL_ERROR "Unexpected collection partitions: ${actual_groups}")
endif()
if(LOCKDC_BUILD_TYPE STREQUAL "Release" AND suite STREQUAL "lc_unit_collections")
    include("${LOCKDC_ROOT}/tests/unit/portability.cmake")
    set(expected ${lc_portability_lc_unit_collections})
else()
    # Definitions independently cover the complete native table, including cases
    # accidentally omitted from the registration macros used by CMake.
    file(READ "${LOCKDC_ROOT}/tests/unit/${source_name}" source)
    string(REGEX MATCHALL "static void[ \r\n]+test_[A-Za-z0-9_]+\\(" functions "${source}")
    set(expected)
    foreach(function IN LISTS functions)
        string(REGEX REPLACE "^static void[ \r\n]+(test_[A-Za-z0-9_]+)\\($" "\\1" name "${function}")
        list(APPEND expected "${name}")
    endforeach()
endif()
list(SORT expected)
list(SORT cases)
if(NOT expected OR NOT cases STREQUAL expected)
    message(FATAL_ERROR "Collection partitions omit or repeat cases")
endif()
