set(dependency_shared_suffix so)
set(dependency_static_nm_args -g --defined-only)
set(dependency_shared_nm_args -D --defined-only)
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    set(dependency_shared_suffix dylib)
    set(dependency_static_nm_args -gU)
    set(dependency_shared_nm_args -gU)
endif()

function(lockdc_dependency_versioned_library output prefix abi)
    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
        set(${output} "${prefix}.${abi}.dylib" PARENT_SCOPE)
    else()
        set(${output} "${prefix}.so.${abi}" PARENT_SCOPE)
    endif()
endfunction()
