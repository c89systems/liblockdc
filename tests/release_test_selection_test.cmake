cmake_minimum_required(VERSION 3.21)
find_program(ctest_bin NAMES ctest REQUIRED)
function(selected_tests selection)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env LC_ALL=C
        "${ctest_bin}" --test-dir "${LOCKDC_BINARY_DIR}" -N ${ARGN}
        RESULT_VARIABLE rc OUTPUT_VARIABLE inventory ERROR_VARIABLE error)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Cannot inspect ${selection} test selection: ${error}")
    endif()
    string(REGEX MATCHALL "Test[ \t]+#[0-9]+: [^\r\n]+" entries "${inventory}")
    if(NOT entries)
        message(FATAL_ERROR "Empty ${selection} test selection")
    endif()
    set(names)
    foreach(entry IN LISTS entries)
        string(REGEX REPLACE "^Test[ \t]+#[0-9]+: " "" name "${entry}")
        list(APPEND names "${name}")
    endforeach()
    set(${selection}_tests "${names}" PARENT_SCOPE)
endfunction()

selected_tests(all)
selected_tests(runtime -LE "lifecycle-host|release-artifact|native-behavior")
selected_tests(cross -L cross-runtime)

# Inspect bounded JSON batches. CMake reparses the JSON on each access.
# Disable automatic fixture additions so each registration is inspected once.
list(LENGTH all_tests test_count)
set(inspected)
foreach(first RANGE 1 ${test_count} 64)
    math(EXPR end "${first} + 63")
    execute_process(COMMAND "${ctest_bin}" --test-dir "${LOCKDC_BINARY_DIR}"
        --show-only=json-v1 -I "${first},${end}" -FA ".*"
        RESULT_VARIABLE rc OUTPUT_VARIABLE inventory ERROR_VARIABLE error)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Cannot inspect tests ${first} through ${end}: ${error}")
    endif()
    string(JSON count LENGTH "${inventory}" tests)
    if(count EQUAL 0)
        message(FATAL_ERROR "Empty test inventory starting at ${first}")
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON test GET "${inventory}" tests ${index})
        string(JSON name GET "${test}" name)
        list(APPEND inspected "${name}")
        if(name STREQUAL "lc_unit_pouch" OR name STREQUAL "lc_unit_outbox")
            string(JSON ${name}_command GET "${test}" command)
        endif()
        string(JSON property_count LENGTH "${test}" properties)
        math(EXPR last_property "${property_count} - 1")
        set(leak_gate FALSE)
        foreach(property RANGE 0 ${last_property})
            string(JSON property_name GET "${test}" properties ${property} name)
            if(property_name STREQUAL "FAIL_REGULAR_EXPRESSION")
                string(JSON patterns GET "${test}" properties ${property} value)
                if(patterns MATCHES "liblockdc allocator:")
                    set(leak_gate TRUE)
                endif()
            endif()
        endforeach()
        if(NOT leak_gate)
            message(FATAL_ERROR "Missing allocator exit gate: ${name}")
        endif()
    endforeach()
endforeach()
if(NOT inspected STREQUAL all_tests)
    message(FATAL_ERROR "Batched CTest inventory differs from the complete selection")
endif()

include("${LOCKDC_ROOT}/tests/unit/portability.cmake")
foreach(target lc_unit_pouch lc_unit_outbox)
    # Collections have their own per-configuration partition contract.
    string(JSON command_length LENGTH "${${target}_command}")
    math(EXPR last_argument "${command_length} - 1")
    set(found_binary FALSE)
    set(arguments)
    foreach(index RANGE 0 ${last_argument})
        string(JSON argument GET "${${target}_command}" ${index})
        if(found_binary)
            list(APPEND arguments "${argument}")
        elseif(argument MATCHES "/${target}$")
            set(found_binary TRUE)
        endif()
    endforeach()
    if(NOT found_binary)
        message(FATAL_ERROR "Missing test binary in command for ${target}")
    endif()
    if(LOCKDC_BUILD_TYPE STREQUAL "Release")
        if(NOT arguments OR NOT arguments STREQUAL lc_portability_${target})
            message(FATAL_ERROR "Wrong portability selection for ${target}: ${arguments}")
        endif()
    elseif(arguments)
        message(FATAL_ERROR "Full native behavioral table was filtered: ${target}")
    endif()
endforeach()
foreach(version 15 16 17 18)
    if(postgres_xa_native_test IN_LIST all_tests AND NOT postgres_xa_pg${version}_test IN_LIST all_tests)
        message(FATAL_ERROR "Full native PostgreSQL version matrix lost PG${version}")
    endif()
    if(postgres_xa_pg${version}_test IN_LIST runtime_tests)
        message(FATAL_ERROR "PostgreSQL version matrix repeated after native Debug")
    endif()
endforeach()
