function(lockdc_acquire_lonejson_lua_rock output)
    set(cache_dir "${LOCKDC_BINARY_DIR}/lua-rock-cache")
    set(rock "${cache_dir}/lonejson-0.50.0-1.src.rock")
    set(url "https://github.com/c89systems/lonejson/releases/download/v0.50.0/lonejson-0.50.0-1.src.rock")
    set(hash "4f329c797e7452ada6fd90bffa8a00f398b3cdcd20f0c6ad89f3fb3f7d664db3")
    file(MAKE_DIRECTORY "${cache_dir}")
    if(EXISTS "${rock}")
        file(SHA256 "${rock}" actual)
        if(NOT actual STREQUAL hash)
            file(REMOVE "${rock}")
        endif()
    endif()
    if(NOT EXISTS "${rock}")
        file(DOWNLOAD "${url}" "${rock}" TLS_VERIFY ON EXPECTED_HASH "SHA256=${hash}"
            STATUS status TIMEOUT 180)
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            file(REMOVE "${rock}")
            message(FATAL_ERROR "failed to download lonejson Lua rock from ${url}: ${status}")
        endif()
    endif()
    set(${output} "${rock}" PARENT_SCOPE)
endfunction()
